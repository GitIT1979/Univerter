{
  "name": "univerter",
  "productName": "Univerter",
  "version": "1.0.0",
  "description": "Univerter — универсальный конвертер документов (десктопная версия)",
  "main": "main.js",
  "author": "Univerter",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.univerter.app",
    "productName": "Univerter",
    "copyright": "Univerter",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [ "main.js", "preload.js", "lib/**", "src/**", "package.json" ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": [ "x64" ] },
        { "target": "portable", "arch": [ "x64" ] }
      ],
      "artifactName": "Univerter-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049",
      "shortcutName": "Univerter"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [ { "target": "dmg", "arch": [ "x64", "arm64" ] } ],
      "artifactName": "Univerter-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [ "AppImage", "deb" ],
      "artifactName": "Univerter-${version}-linux-${arch}.${ext}"
    }
  }
}
